<?xml version="1.0" encoding="utf-8"?>
<!-- Android 11 and earlier (fullBackupContent). Same rule as data_extraction_rules.xml. -->
<full-backup-content>
    <exclude domain="file" path="signatures/" />
    <!-- Recents hold URIs whose read permission doesn't survive a restore. -->
    <exclude domain="database" path="pdftoolkit.db" />
    <exclude domain="database" path="pdftoolkit.db-shm" />
    <exclude domain="database" path="pdftoolkit.db-wal" />
</full-backup-content>
