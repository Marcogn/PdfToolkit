<?xml version="1.0" encoding="utf-8"?>
<!-- Android 12+ (API 31). Le firme non vanno né nel backup cloud né nel trasferimento tra
     dispositivi (SPEC §6.5). -->
<data-extraction-rules>
    <cloud-backup>
        <exclude domain="file" path="signatures/" />
    </cloud-backup>
    <device-transfer>
        <exclude domain="file" path="signatures/" />
    </device-transfer>
</data-extraction-rules>
