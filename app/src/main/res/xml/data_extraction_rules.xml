<?xml version="1.0" encoding="utf-8"?>
<!-- Android 12+ (API 31). Signatures go neither into cloud backup nor into device-to-device
     transfer (spec §6.5). -->
<data-extraction-rules>
    <cloud-backup>
        <exclude domain="file" path="signatures/" />
    </cloud-backup>
    <device-transfer>
        <exclude domain="file" path="signatures/" />
    </device-transfer>
</data-extraction-rules>
