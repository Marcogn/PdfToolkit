<?xml version="1.0" encoding="utf-8"?>
<!-- Android 12+ (API 31). Signatures go neither into cloud backup nor into device-to-device
     transfer (spec §6.5); neither does the database, whose recents hold URIs
     with permissions that don't survive a restore. -->
<data-extraction-rules>
    <cloud-backup>
        <exclude domain="file" path="signatures/" />
        <exclude domain="database" path="pdftoolkit.db" />
        <exclude domain="database" path="pdftoolkit.db-shm" />
        <exclude domain="database" path="pdftoolkit.db-wal" />
    </cloud-backup>
    <device-transfer>
        <exclude domain="file" path="signatures/" />
        <exclude domain="database" path="pdftoolkit.db" />
        <exclude domain="database" path="pdftoolkit.db-shm" />
        <exclude domain="database" path="pdftoolkit.db-wal" />
    </device-transfer>
</data-extraction-rules>
