<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools">

    <!-- Update check and download (plan A, ADR 0006): the only use of the network. The product phase 1
         rule "no INTERNET" ended with this. CI checks the packaged manifest
         (.github/workflows/android-ci.yml). -->
    <uses-permission android:name="android.permission.INTERNET" />
    <!-- Hands the downloaded APK to the system installer; Android asks the user for "install unknown
         apps" the first time. -->
    <uses-permission android:name="android.permission.REQUEST_INSTALL_PACKAGES" />

    <!-- Background save (ADR 0003): WorkManager runs the save as expedited work, promoted to a
         foreground service of type dataSync on Android 11 and earlier or when the system asks. -->
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE" />
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE_DATA_SYNC" />

    <!-- All files access (ADR 0007): a PDF another app hands over with a temporary grant is kept in
         recents by its path. Android 11+: MANAGE_EXTERNAL_STORAGE, granted on a system settings page;
         Android 8-10: the old storage permissions (legacy storage on Android 10). Asked only when such
         a PDF arrives, and optional: without it the app works as before. -->
    <uses-permission
        android:name="android.permission.MANAGE_EXTERNAL_STORAGE"
        tools:ignore="ScopedStorage" />
    <uses-permission
        android:name="android.permission.READ_EXTERNAL_STORAGE"
        android:maxSdkVersion="29" />
    <uses-permission
        android:name="android.permission.WRITE_EXTERNAL_STORAGE"
        android:maxSdkVersion="29" />

    <!-- Auto Backup: signatures in filesDir/signatures/ are excluded (spec §6.5). -->
    <application
        android:name=".PdfToolkitApplication"
        android:allowBackup="true"
        android:dataExtractionRules="@xml/data_extraction_rules"
        android:fullBackupContent="@xml/backup_rules"
        android:icon="@mipmap/ic_launcher"
        android:label="@string/app_name"
        android:localeConfig="@xml/locales_config"
        android:roundIcon="@mipmap/ic_launcher_round"
        android:requestLegacyExternalStorage="true"
        android:supportsRtl="true"
        android:theme="@style/Theme.PdfToolkit"
        tools:targetApi="33">

        <!-- Automatic persistence of the language chosen with AppCompatDelegate.setApplicationLocales()
             (autoStoreLocales), as in the reference projects. -->
        <service
            android:name="androidx.appcompat.app.AppLocalesMetadataHolderService"
            android:enabled="false"
            android:exported="false">
            <meta-data
                android:name="autoStoreLocales"
                android:value="true" />
        </service>

        <service
            android:name="androidx.work.impl.foreground.SystemForegroundService"
            android:foregroundServiceType="dataSync"
            tools:node="merge" />

        <!-- ML Kit telemetry off (ADR 0006): its usage metrics go through datatransport's "cct"
             backend, registered by this meta-data. Without it the runtime refuses those events
             ("Transport backend 'cct' is not registered", DefaultScheduler) before storing them, and
             the uploader drops any batch for an unknown backend. Not a documented Google switch:
             TelemetryOffTest guards the merged manifest, the device check confirms the traffic. -->
        <service
            android:name="com.google.android.datatransport.runtime.backends.TransportBackendDiscovery"
            tools:node="merge">
            <meta-data
                android:name="backend:com.google.android.datatransport.cct.CctBackendFactory"
                tools:node="remove" />
        </service>

        <!-- Shares a PDF opened by path (ADR 0007): other apps can't receive file:// URIs. -->
        <provider
            android:name="androidx.core.content.FileProvider"
            android:authorities="${applicationId}.files"
            android:exported="false"
            android:grantUriPermissions="true">
            <meta-data
                android:name="android.support.FILE_PROVIDER_PATHS"
                android:resource="@xml/file_paths" />
        </provider>

        <!-- PackageInstaller session status (explicit PendingIntent from ApkInstaller). -->
        <receiver
            android:name=".data.update.UpdateInstallReceiver"
            android:exported="false" />

        <activity
            android:name=".MainActivity"
            android:exported="true"
            android:theme="@style/Theme.PdfToolkit">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>

            <!-- Open with PdfToolkit from a file manager, a download or a mail attachment (spec §4). -->
            <intent-filter>
                <action android:name="android.intent.action.VIEW" />
                <category android:name="android.intent.category.DEFAULT" />
                <data android:scheme="content" />
                <data android:scheme="file" />
                <data android:mimeType="application/pdf" />
            </intent-filter>

            <!-- "Share" a PDF to PdfToolkit. -->
            <intent-filter>
                <action android:name="android.intent.action.SEND" />
                <category android:name="android.intent.category.DEFAULT" />
                <data android:mimeType="application/pdf" />
            </intent-filter>
        </activity>
    </application>

</manifest>
