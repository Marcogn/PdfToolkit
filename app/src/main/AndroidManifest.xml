<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools">

    <!-- Fase 1 del prodotto: nessuna connessione di rete (SPEC §1). Il permesso non è dichiarato
         e, se una dipendenza provasse ad aggiungerlo tramite manifest merger, viene tolto qui.
         La CI controlla il manifest unito (.github/workflows/android-ci.yml). -->
    <uses-permission
        android:name="android.permission.INTERNET"
        tools:node="remove" />

    <!-- Backup automatico: le firme in filesDir/signatures/ sono escluse (SPEC §6.5). -->
    <application
        android:name=".PdfToolkitApplication"
        android:allowBackup="true"
        android:dataExtractionRules="@xml/data_extraction_rules"
        android:fullBackupContent="@xml/backup_rules"
        android:icon="@mipmap/ic_launcher"
        android:label="@string/app_name"
        android:localeConfig="@xml/locales_config"
        android:roundIcon="@mipmap/ic_launcher_round"
        android:supportsRtl="true"
        android:theme="@style/Theme.PdfToolkit"
        tools:targetApi="33">

        <!-- Persistenza automatica della lingua scelta con AppCompatDelegate.setApplicationLocales()
             (autoStoreLocales), come nei progetti di riferimento. -->
        <service
            android:name="androidx.appcompat.app.AppLocalesMetadataHolderService"
            android:enabled="false"
            android:exported="false">
            <meta-data
                android:name="autoStoreLocales"
                android:value="true" />
        </service>

        <activity
            android:name=".MainActivity"
            android:exported="true"
            android:theme="@style/Theme.PdfToolkit">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
        </activity>
    </application>

</manifest>
